{
    "id" : "org.yggotine_plus.Yggotine",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "yggotine",
    "separate-locales" : false,
    "finish-args" : [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--filesystem=home",
        "--filesystem=xdg-run/gvfs",
        "--filesystem=/media",
        "--filesystem=/mnt",
        "--filesystem=/run/media",
        "--talk-name=org.a11y.Bus",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.mpris.MediaPlayer2.*"
    ],
    "modules" : [
        {
            "name" : "yggotine-plus",
            "buildsystem" : "simple",
            "build-commands" : [
                "pip3 install --no-build-isolation --no-deps --prefix=${FLATPAK_DEST} ."
            ],
            "sources" : [
                {
                    "path" : "../../",
                    "type" : "dir"
                }
            ],
            "run-tests" : true,
            "test-commands" : [
                "python3 -m unittest -v"
            ]
        }
    ],
    "build-options" : {
        "env" : {        }
    }
}
